# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C++ files
[*.{cpp,h,hpp,cc,cxx}]
indent_style = space
indent_size = 4

# CMake files
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

# JSON files
[*.json]
indent_style = space
indent_size = 4

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Visual Studio solution and project files
[*.{sln,vcxproj,vcxproj.filters}]
indent_style = tab
charset = utf-8-bom

# Windows batch files
[*.{cmd,bat}]
end_of_line = crlf

# PowerShell files
[*.ps1]
indent_style = space
indent_size = 4
end_of_line = crlf
